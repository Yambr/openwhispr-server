{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "lint",
      "typecheck",
      "test",
      "mutation-quick",
      "lint-english",
      "pr-checklist",
      "gitleaks",
      "trivy-fs",
      "codeql",
      "license-scan",
      "harness-self-check",
      "lint-rls",
      "lint-tenant-context",
      "test-migration",
      "contract-test",
      "verify-images",
      "lint-gherkin-tags",
      "lint-playwright-config",
      "lint-steps-have-unit-tests",
      "prod-edit-guard",
      "coverage-floor",
      "smoke"
    ]
  },
  "enforce_admins": true,
  "required_pull_request_reviews": {
    "required_approving_review_count": 1,
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": false
  },
  "restrictions": null,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "required_conversation_resolution": true,
  "lock_branch": false,
  "allow_fork_syncing": true
}
