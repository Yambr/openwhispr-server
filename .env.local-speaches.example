# OpenWhispr Server — Variant C operator env scaffold
# Pairs with OpenWhispr desktop client: https://github.com/Yambr/openwhispr/releases
# Client pairing guide: docs/client.md
#
# Variant C = embedded LiteLLM + local Speaches (CPU or GPU). All
# transcription + diarization stays inside the docker-compose network;
# LLM calls (reason / agent-stream) still route to the operator's
# hosted catalog (OpenRouter / OpenAI) via the embedded LiteLLM proxy.
#
# Usage:
#   cp .env.local-speaches.example .env
#   # replace every REPLACE_ME with a real value
#   docker compose \
#     -f compose/docker-compose.embedded-litellm.yml \
#     -f examples/docker-compose.local-speaches.yml \
#     up -d --wait
#
# WARNING: GPU is strongly recommended for production. First boot
# downloads several GB of weights (Whisper); subsequent boots
# reuse the `speaches_models` named volume.

# --- Variant C only -------------------------------------------------
# HF_TOKEN required to download gated model weights at Speaches
# container boot (e.g. Whisper-large-v3 and other gated HF repos).
#
# Request at https://huggingface.co/settings/tokens with `read` access.
# Without HF_TOKEN, the Speaches container refuses to start (compose's
# `${VAR:?...}` guard) — by design, since local transcription is core to
# Variant C. Operators who prefer a hosted Whisper API should use
# Variant A (embedded LiteLLM + hosted Whisper API) instead.
HF_TOKEN=REPLACE_ME

# --- GPU vs CPU build (optional) ----------------------------------------
# Default is CPU (BASE_IMAGE=ubuntu:24.04). GPU operators flip:
#   SPEACHES_BASE_IMAGE=nvidia/cuda:12.6.3-base-ubuntu24.04
# AND install nvidia-container-runtime on the host BEFORE
# `docker compose up --wait`. The chart's values overlay has the
# equivalent toggle as `.bundledAi.speaches.image`.
SPEACHES_BASE_IMAGE=ubuntu:24.04

# --- LiteLLM Proxy + provider keys --------------------------------------
# Variant C still uses the embedded LiteLLM; LLM aliases (reason +
# agent-stream) route through it to OpenRouter / OpenAI via these keys.
# Speaches handles transcription (whisper-large-v3 alias swapped in via
# litellm_config.local-speaches.yaml).
LITELLM_MASTER_KEY=REPLACE_ME
OPENROUTER_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME

# LITELLM_USER_HEADER_NAME — OPT-IN end-user EMAIL attribution (upstream #4).
# When set, every gateway call carries the authenticated user's email in this
# header. Body `user` always carries email-or-UUID; x-litellm-end-user-id
# stays the stable UUID. Header NAME must be a single token (CR/LF and `:`
# refused at boot). Unset → no email header.
# LITELLM_USER_HEADER_NAME=X-OpenWhispr-User-Email

# REALTIME_FORCE_TRANSCRIPTION_MODEL — default true (upstream #1.5): operator
# model from REALTIME_TRANSCRIPTION_MODEL wins over a client-supplied realtime
# model; client `language` still passes through. Set 0/false to honor client.
# REALTIME_FORCE_TRANSCRIPTION_MODEL=true

# --- Better Auth + Postgres + Valkey ------------------------------------
BETTER_AUTH_SECRET=REPLACE_ME
POSTGRES_OWNER_PASSWORD=REPLACE_ME
POSTGRES_APP_PASSWORD=REPLACE_ME
VALKEY_PASSWORD=REPLACE_ME

# --- Envelope-encryption key (LOCKER-08 boot gate) ----------------------
MASTER_KEK=REPLACE_ME

# --- TLS (Traefik) ------------------------------------------------------
TRAEFIK_ADMIN_PASSWORD=REPLACE_ME
