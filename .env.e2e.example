# OpenWhispr Server — .env.e2e template
# Pairs with OpenWhispr desktop client: https://github.com/Yambr/openwhispr/releases
# Client pairing guide: docs/client.md
#
# Copy to .env.e2e (gitignored via the .env.* glob) and paste REAL provider
# keys. `make e2e-test` reads this file IN ADDITION to .env and exercises the
# contract suite against live provider APIs. Costs real money — operator runs
# locally or via scheduled (NOT main) CI.

# OpenRouter — chat / reasoning models (D-06 default qwen3.6-plus, D-10 fallback).
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=PLACEHOLDER_REAL_OPENROUTER_KEY

# Groq — Whisper-large-v3 STT (D-11). Fastest hosted Whisper variant.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=PLACEHOLDER_REAL_GROQ_KEY

# OpenAI — Realtime WSS direct (D-12 / gpt-realtime model).
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=PLACEHOLDER_REAL_OPENAI_KEY

# pyannote.ai — diarization (D-07 REVISED). Consumed by the Fastify
# /v1/audio/diarization route directly (NOT by the LiteLLM container).
# Get a key: https://dashboard.pyannote.ai/
PYANNOTE_API_KEY=PLACEHOLDER_REAL_PYANNOTE_KEY
