# OpenWhispr Server — Variant B operator env scaffold
# Pairs with OpenWhispr desktop client: https://github.com/Yambr/openwhispr/releases
# Client pairing guide: docs/client.md
#
# Variant B = external/corporate LiteLLM. The OpenWhispr server points
# api+worker at an existing LiteLLM Proxy operated elsewhere (Bedrock
# proxy, in-house LiteLLM, vLLM gateway, etc. — see
# docs/litellm-target-spec.md for the wire contract this corporate
# proxy MUST honour).
#
# Usage:
#   cp .env.external.example .env
#   # replace every REPLACE_ME with a real value (see provenance pointers)
#   docker compose -f docker-compose.external-litellm.yml up -d --wait
#
# This file carries ONLY the keys Variant B requires. No HF_TOKEN, no
# bundled-model provider keys (OPENROUTER_API_KEY, OPENAI_API_KEY,
# etc.) — every model call routes through the
# corporate LiteLLM, which owns its own upstream credentials.
#
# Generate strong random secrets with:
#   openssl rand -hex 32          # for *_SECRET, *_KEY hex tokens
#   openssl rand -base64 32 | tr -d /=+   # for *_PASSWORD
#   age-keygen -o -               # for BACKUP_AGE_IDENTITY
#   openssl rand 32 | basenc --base64url -w0 | tr -d =   # for MASTER_KEK

# --- External LiteLLM endpoint (REQUIRED) -------------------------------
# LITELLM_BASE_URL — corporate LiteLLM Proxy URL the api+worker route to.
# MUST be reachable from inside the docker-compose network. If your
# corporate LiteLLM listens on a host outside the compose network, set
# this to a routable address (e.g. https://litellm.corp.internal/).
LITELLM_BASE_URL=https://litellm.corp.internal/

# LITELLM_VIRTUAL_KEY — bearer the api+worker present to the corporate
# LiteLLM (if it requires per-tenant virtual keys per
# docs/litellm-target-spec.md §2 "Authentication"). Leave blank if the
# corporate proxy authenticates on network identity (mTLS, VPN) alone.
LITELLM_VIRTUAL_KEY=

# LITELLM_USER_HEADER_NAME — OPT-IN end-user EMAIL attribution (upstream #4).
# When set, every gateway call carries the authenticated user's email in this
# header so your corporate LiteLLM attributes spend by human-readable identity.
# Body `user` always carries email-or-UUID regardless; x-litellm-end-user-id
# stays the stable UUID. The header NAME must be a single token (CR/LF and `:`
# refused at boot). Unset → no email header.
# LITELLM_USER_HEADER_NAME=X-OpenWhispr-User-Email

# REALTIME_FORCE_TRANSCRIPTION_MODEL — default true (upstream #1.5): the
# operator model from REALTIME_TRANSCRIPTION_MODEL wins over a client-supplied
# realtime transcription model; client `language` still passes through. Set
# 0/false to honor the client model.
# REALTIME_FORCE_TRANSCRIPTION_MODEL=true


# --- Better Auth + Postgres + Valkey ------------------------------------
BETTER_AUTH_SECRET=REPLACE_ME
POSTGRES_OWNER_PASSWORD=REPLACE_ME
POSTGRES_APP_PASSWORD=REPLACE_ME
VALKEY_PASSWORD=REPLACE_ME

# --- Envelope encryption key (LOCKER-08 boot gate) ----------------------
# MASTER_KEK — wraps every per-credential DEK. Loss of this key bricks
# every encrypted secret at rest. Production operators MUST persist it
# in their KMS/Vault (see docs/security.md §12).
MASTER_KEK=REPLACE_ME

# --- TLS (Traefik) ------------------------------------------------------
# Single-host self-host on Mac/Linux dev uses mkcert (see `make tls-trust`).
# Corporate deployments override Traefik dynamic config to point at the
# internal-CA chain — see docs/operations.md §TLS.
TRAEFIK_ADMIN_PASSWORD=REPLACE_ME

# --- Optional observability stack (OFF by default in Variant B) ---------
# Set these only if you ALSO enable compose/docker-compose.observability.yml
# overlay. Most corporate deployments scrape api/worker via their existing
# Prometheus + Loki + Tempo, in which case this stack is unused.
GRAFANA_ADMIN_PASSWORD=
