# =========================================================================
# OpenWhispr Server — slim-core operator env template (Phase 14, SLIM-03).
# =========================================================================
#
# This is the canonical OSS quickstart template. The slim-core base brings
# up exactly 6 services (api, web, worker, postgres, valkey, litellm).
# Overlays (storage, observability, ingress, pgbouncer, dev-tools) are
# additive — uncomment the matching section below AND add
# `-f compose/docker-compose.<overlay>.yml` to your `docker compose`
# invocation. See docs/operations.md#byok-environment-matrix for the full
# overlay × BYOK-env × loud-fail-code reference.
#
# QUICKSTART
# ----------
#   git clone <repo> && cd openwhispr-server
#   cp .env.slim.example .env
#   # Edit .env: set OPENROUTER_API_KEY=<your key from https://openrouter.ai/keys>
#   ./tools/bootstrap.sh              # auto-fills every PLACEHOLDER_* slot
#   docker compose up                 # 6 services, ready
#
# WHY ONLY 5 USER-VISIBLE INPUTS
# ------------------------------
# Every other value is either (a) a sane localhost default, (b) a derived
# URL composed from earlier keys via ${VAR} interpolation, or (c) a secret
# tools/bootstrap.sh fills with `openssl rand` on first run. Operators
# wanting the full 90-key reference can `cp .env.full.example .env` and
# set `BOOTSTRAP_ENV_TEMPLATE=.env.full.example ./tools/bootstrap.sh`.
#
# UPGRADE PATH FROM .env.example
# ------------------------------
# Existing operators with a hand-tuned .env built from the legacy 90-key
# template:
#   cp .env.slim.example .env.new
#   diff .env .env.new                # review which keys you actually need
#   # Copy your operator-set values across; keep PLACEHOLDER_BOOTSTRAP_WILL_REPLACE
#   # on every secret you want bootstrap to (re)generate.
#   mv .env.new .env && ./tools/bootstrap.sh
# See docs/operations.md#byok-environment-matrix for which overlay you
# need to (re-)enable to keep your current behavior.
# =========================================================================


# -------------------------------------------------------------------------
# 1. USER-VISIBLE MANDATORY INPUTS  (CONTEXT decision 4 — exactly 5 keys)
# -------------------------------------------------------------------------

# Postgres app-role password — the non-BYPASSRLS role api/worker connect as.
# DATABASE_URL below interpolates this. bootstrap.sh fills the placeholder.
POSTGRES_APP_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Better Auth session-signing secret. Rotating invalidates every live session.
# bootstrap.sh fills the placeholder with `openssl rand -base64 32` output.
BETTER_AUTH_SECRET=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# LiteLLM master bearer — auth between api/worker and the bundled LiteLLM
# proxy. bootstrap.sh fills the placeholder.
LITELLM_MASTER_KEY=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Public origin where the api is reachable. Drives Better Auth cookie
# domain + CORS allow-list. Localhost default is fine for dev; set to your
# public HTTPS URL (e.g. https://api.example.com) before any non-local deploy.
BETTER_AUTH_URL=http://localhost:3000

# R19 follow-up facet — INGRESS_BASE_URL is the canonical API origin.
# Better Auth builds the verification-email link from it
# (`<INGRESS_BASE_URL>/api/auth/verify-email?token=...`). On the
# no-Traefik slim profile the api is published on host port 4000
# (compose `4000:3000`), so the EXTERNALLY REACHABLE origin is
# `http://localhost:4000`. The internal Traefik hostname
# `https://api.localhost` does NOT resolve from a mail client, so a
# verification email built from it has a dead link.
#
# REQUIRED for slim-core operators: set INGRESS_BASE_URL (and the two
# vars below) to the origin a user's browser/mail client can actually
# reach — `http://localhost:4000` for a local single-host deploy, or
# your public origin (e.g. https://openwhispr.example.com) once you
# front the stack with a reverse proxy. AUTH_URL / OPENWHISPR_API_URL
# feed Better Auth's CSRF/Origin allow-list and must match.
INGRESS_BASE_URL=http://localhost:4000
AUTH_URL=http://localhost:4000
OPENWHISPR_API_URL=http://localhost:4000

# Phase 15 / Plan 02 (STRUCT-05) — Better Auth trustedOrigins env extension.
# See .env.full.example for full context. Comma-separated additional
# origins admitted by Better Auth's CSRF gate when running the split-host
# dev stack (web.localhost + api.localhost via Traefik).
AUTH_TRUSTED_ORIGINS_EXTRA=https://web.localhost,https://api.localhost,http://web.localhost,http://api.localhost,http://localhost:4000,http://localhost:3000

# OpenRouter API key — powers /api/reason via the bundled LiteLLM proxy.
# Leave empty for the loud 503 envelope on first /api/reason hit, or paste
# your key from https://openrouter.ai/keys. The slim path includes
# /api/reason; corporate operators may instead point LiteLLM at an
# internal model gateway via the litellm config (see docs/litellm-target-spec.md).
OPENROUTER_API_KEY=

# D1 — server-injected realtime model alias. WSS /v1/realtime forces this
# value onto the upstream `?model=` query string (overwriting whatever the
# desktop client sent), so the realtime model is pure operator config and
# the immutable desktop client carries no provider-specific model name.
# This is the LiteLLM `model_name`, NOT the upstream provider model — to
# switch OpenAI→Speaches retarget the `realtime-default` alias in
# compose/litellm/litellm_config.yaml, NOT here.
LITELLM_REALTIME_MODEL=realtime-default

# R31 — realtime-relay upstream backend. The frame-aware WSS /v1/realtime
# relay translates the desktop client's OpenAI-Realtime *Beta* event
# vocabulary to/from OpenAI's GA vocabulary. It supports two upstream
# backends, selected here:
#
#   direct   (default)  The relay connects STRAIGHT to OpenAI's GA
#                        wss://api.openai.com/v1/realtime, bypassing
#                        LiteLLM. The api process controls every upstream
#                        header so no retired `OpenAI-Beta` header is ever
#                        sent. This mode REQUIRES OPENAI_API_KEY (below)
#                        readable by the api process — the relay uses it as
#                        the upstream Bearer credential.
#
#   litellm              The relay connects to the bundled LiteLLM
#                        /v1/realtime; LiteLLM dials OpenAI. For corporate
#                        operators whose internal LiteLLM speaks OpenAI
#                        Realtime GA. NOTE: the bundled LiteLLM 1.83.14
#                        CANNOT complete an OpenAI Realtime GA session —
#                        it injects the retired `OpenAI-Beta` header on its
#                        own OpenAI leg from a code path no config knob
#                        covers. Use `direct` until LiteLLM ships a GA-
#                        capable realtime release.
#
# An unrecognized value is a boot-fatal config error (the api exits 78).
# Leave commented to use the `direct` default; uncomment to switch.
# REALTIME_BACKEND=direct

# direct-mode — OpenAI API key the api process uses as the upstream
# realtime credential. REQUIRED for the default `direct` backend. Read
# ONLY when REALTIME_BACKEND=direct; in litellm mode LiteLLM owns the
# provider key and the api never reads this. In direct mode an unset key
# makes the api refuse /v1/realtime WS upgrades (operator-actionable)
# rather than booting broken.
# OPENAI_API_KEY=sk-...

# direct-mode only — override the OpenAI GA realtime WS endpoint (e.g. for
# an egress proxy or Azure OpenAI). Leave unset for the public default
# wss://api.openai.com/v1/realtime.
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# direct-mode only — the `?model=` value sent to OpenAI's GA /v1/realtime.
# OpenAI REQUIRES a real model name (a model-less connect is rejected
# `missing_model`). Defaults to `gpt-realtime`. In litellm mode the
# LiteLLM routing alias (LITELLM_REALTIME_MODEL) is used instead and this
# var is ignored.
# OPENAI_REALTIME_MODEL=gpt-realtime

# R31 DEFECT 6 — relay-injected transcription session config.
# The OpenWhispr desktop client runs PRECONFIGURED on the cloud path: it
# DELIBERATELY never sends a session.update (it assumes the server
# configured the transcription session). The /v1/realtime relay therefore
# ITSELF injects a GA session.update on every upstream connection, carrying
# this transcription config. Applies to BOTH backends (direct + litellm).
#
# The transcription model. Default `gpt-4o-transcribe` — the broadly-
# available GA realtime-transcription model. CAVEAT: `gpt-4o-transcribe`
# is scheduled to retire ~June 2026; operators running past that date MUST
# pin a current model here (`gpt-4o-transcribe-diarize` if their OpenAI
# org has the grant, else the then-current model). In litellm mode this is
# the internal LiteLLM transcription model alias.
# REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# PCM input sample rate (Hz) the client streams. Default 24000.
# REALTIME_INPUT_AUDIO_RATE=24000
# server_vad turn-detection tuning. Defaults: 0.6 / 600ms / 500ms.
# REALTIME_VAD_THRESHOLD=0.6
# REALTIME_VAD_SILENCE_MS=600
# REALTIME_VAD_PREFIX_PADDING_MS=500


# -------------------------------------------------------------------------
# 2. BOOTSTRAP-INVISIBLE SECRETS  (RESEARCH section D.2 — bootstrap fills)
# -------------------------------------------------------------------------
# Operators normally never see these; bootstrap.sh detects the placeholder
# literal and replaces it with `openssl rand` output. Listed here only so
# the canonical key set is grep-able from the template and so bootstrap
# discovers them on first run.

# Postgres OWNER role password — used by migrations + admin paths only.
POSTGRES_OWNER_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Valkey AUTH password — set in compose env on the valkey service and
# interpolated into VALKEY_URL below.
VALKEY_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Master KEK (key-encryption key) — encrypts at-rest user secrets (LiteLLM
# virtual keys, OIDC client secrets, etc.) inside Postgres.
MASTER_KEK=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# age X25519 identity used by `make backup` to encrypt nightly Postgres
# dumps. bootstrap.sh prefers `age-keygen`; falls back to openssl with a
# stderr warning when age is not installed.
BACKUP_AGE_IDENTITY=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE


# -------------------------------------------------------------------------
# 3. OTEL DISABLE SENTINEL  (CONTEXT decision 5)
# -------------------------------------------------------------------------
# The api refuses to start if observability overlay is OFF AND
# OTEL_EXPORTER_OTLP_ENDPOINT is unset (loud-fail BYOK_OBSERVABILITY_REQUIRED).
# The literal value `disabled` is the explicit opt-out: the SDK short-
# circuits, no exporter is wired. Operators enabling the observability
# overlay change this to `http://otel-collector:4317` (or their corp OTLP
# endpoint).
OTEL_EXPORTER_OTLP_ENDPOINT=disabled


# -------------------------------------------------------------------------
# 3b. OPERATOR-OWNED MODEL ALIASES  (D2/D3a/D4)
# -------------------------------------------------------------------------
# The api forwards these alias strings to the LiteLLM proxy, whose catalog
# resolves each to a concrete provider+model. They are NOT baked into
# TypeScript — retarget every AI route by editing these alone. Leave unset
# to use the bundled defaults shown.
#   LITELLM_DEFAULT_CHAT_MODEL — /api/reason + /api/agent/stream default
#   LITELLM_STT_MODEL          — /api/transcribe default
#   LITELLM_REALTIME_MODEL     — realtime + /api/openai-realtime-token default
#   REASONING_CLEANUP_MODEL    — /api/reason FAST cleanup-class model (R33).
#                                The api routes dictation-cleanup requests
#                                (no agentName / systemPrompt / model) to this
#                                alias with reasoning/thinking disabled. The
#                                thinking-off flag travels in the request body
#                                — it is NOT a litellm_config.yaml setting.
# LITELLM_DEFAULT_CHAT_MODEL=qwen3.6-plus
# LITELLM_STT_MODEL=whisper-large-v3
# LITELLM_REALTIME_MODEL=gpt-realtime
# REASONING_CLEANUP_MODEL=qwen3.6-cleanup


# -------------------------------------------------------------------------
# 3c. STREAMING-TOKEN PROVIDER ENDPOINTS  (advanced — leave unset for defaults)
# -------------------------------------------------------------------------
# The three streaming-token-mint routes (/api/openai-realtime-token,
# /api/streaming-token [AssemblyAI], /api/deepgram-streaming-token) call
# their provider's HTTP API directly via undici (NOT through LiteLLM). The
# upstream endpoint URLs below are NOT baked into TypeScript — override one
# to route the mint through a corporate proxy or a regional endpoint
# without any code change. Leave every line commented to use the
# bundled-default public endpoints shown.
#
#   OPENAI_REALTIME_TOKEN_URL    — OpenAI Realtime client-secret endpoint
#   OPENAI_REALTIME_WHISPER_MODEL — Whisper model alias emitted in the
#                                   upstream session.input_audio_transcription
#                                   block when the client sends a `language`
#   ASSEMBLYAI_TOKEN_URL         — AssemblyAI v3 streaming-token endpoint
#                                   (the dynamic `?expires_in_seconds=` query
#                                   param is appended by the route)
#   DEEPGRAM_TOKEN_URL           — Deepgram Grant Token endpoint
# OPENAI_REALTIME_TOKEN_URL=https://api.openai.com/v1/realtime/client_secrets
# OPENAI_REALTIME_WHISPER_MODEL=whisper-1
# ASSEMBLYAI_TOKEN_URL=https://streaming.assemblyai.com/v3/token
# DEEPGRAM_TOKEN_URL=https://api.deepgram.com/v1/auth/grant
#
# Provider HTTP timeouts (milliseconds) shared by all three mint routes.
# PROVIDER_TOTAL_TIMEOUT_MS caps the whole connect+body budget;
# PROVIDER_CONNECT_TIMEOUT_MS caps the TCP-handshake stage. A non-numeric
# or non-positive value is ignored (the route keeps the bundled default)
# and warn-logged at boot.
# PROVIDER_TOTAL_TIMEOUT_MS=5000
# PROVIDER_CONNECT_TIMEOUT_MS=3000

# 3d. LITELLM CLIENT TIMEOUTS  (optional operator override)
# -------------------------------------------------------------------------
# undici timeout posture for the api -> LiteLLM proxy hop. Leave unset to
# use the bundled defaults shown. Values are positive integer milliseconds;
# a blank or non-integer value is ignored and falls back to the default.
# A per-request override in code still wins over these.
#   LITELLM_HEADERS_TIMEOUT_MS      — headersTimeout for chat / transcribe /
#                                     passthrough (NOT the long-lived SSE
#                                     stream). Default 30000 (30s).
#   LITELLM_BODY_TIMEOUT_MS         — bodyTimeout for the same non-streaming
#                                     methods. Raise this for long audio
#                                     transcriptions. Default 120000 (120s).
#   LITELLM_ERROR_DRAIN_TIMEOUT_MS  — bound on draining a non-2xx upstream
#                                     error body on the streaming path.
#                                     Default 15000 (15s).
# LITELLM_HEADERS_TIMEOUT_MS=30000
# LITELLM_BODY_TIMEOUT_MS=120000
# LITELLM_ERROR_DRAIN_TIMEOUT_MS=15000


# -------------------------------------------------------------------------
# 4. DERIVED (do not edit — composed from the keys above via ${VAR})
# -------------------------------------------------------------------------
DATABASE_URL=postgres://openwhispr_app:${POSTGRES_APP_PASSWORD}@postgres:5432/openwhispr?sslmode=disable
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0
LITELLM_BASE_URL=http://litellm:4000


# =========================================================================
# OPT-IN OVERLAYS — uncomment the matching section AND add
#   `-f compose/docker-compose.<overlay>.yml`
# to your `docker compose` invocation. The api loud-fails (Pino fatal +
# process.exit(1), see apps/api/src/lib/byok-guard.ts and CONTEXT decision 2)
# when an overlay is OFF AND its BYOK env is unset.
# =========================================================================


# --- --with-storage ------------------------------------------------------
# REQUIRES: compose/docker-compose.storage.yml
# Adds MinIO single-disk for the S3 surface. Loud-fail code when overlay
# OFF and any of these are unset (and S3_ENDPOINT is set): BYOK_STORAGE_REQUIRED.
# Corporate operators point S3_ENDPOINT at their AWS/GCS/internal-MinIO.
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=openwhispr
# S3_SECRET_KEY=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE
# S3_BUCKET=openwhispr


# --- --with-observability ------------------------------------------------
# REQUIRES: compose/docker-compose.observability.yml
# Adds OTel Collector + Tempo + Loki + Mimir + Grafana (LGTM stack).
# Loud-fail code when overlay OFF and OTEL_EXPORTER_OTLP_ENDPOINT unset
# (and not equal to the `disabled` sentinel above): BYOK_OBSERVABILITY_REQUIRED.
# Uncomment + replace the `disabled` sentinel in section 3 to point at the
# overlay's collector (default below) or a corp BYOK endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=openwhispr-api


# --- --with-ingress ------------------------------------------------------
# REQUIRES: compose/docker-compose.ingress.yml
# Adds Traefik 3 with ACME. Required for public hostnames + Let's Encrypt.
# Loud-fail code when overlay OFF and INGRESS_BASE_URL unset: BYOK_INGRESS_REQUIRED.
# INGRESS_BASE_URL=https://openwhispr.example.com
# ACME_EMAIL=ops@example.com
# TRAEFIK_ADMIN_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE


# --- --with-pgbouncer ----------------------------------------------------
# REQUIRES: compose/docker-compose.pgbouncer.yml
# Adds PgBouncer transaction-mode pooler. The overlay rewrites DATABASE_URL
# to point at the pooler; no operator change to DATABASE_URL needed.
# Loud-fail code when DATABASE_URL is malformed: BYOK_DATABASE_REQUIRED.
# PGBOUNCER_ADMIN_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE


# --- SMTP / email --------------------------------------------------------
# The base stack ships Mailpit (a dev/test SMTP catch-all) behind the
# `dev` compose profile. Bring it up with `docker compose --profile dev
# up -d` to deliver verification email end-to-end during development;
# read delivered messages at http://127.0.0.1:8025. The api + worker
# reach Mailpit by compose service name on port 1025. These are the
# dev-profile defaults:
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@openwhispr.local
# Corporate operators: point SMTP_HOST / SMTP_PORT at your own relay.
# When SMTP_HOST is unset, email features loud-fail at send time
# (BYOK_SMTP_REQUIRED — matches the createEmailSender precedent).

# EMAIL_FALLBACK_NONFATAL — worker BullMQ email-delivery carve-out.
# When `1`/`true`, the worker treats an `smtp-not-configured` send
# result as a non-fatal no-op: the email-delivery job resolves cleanly
# instead of throwing, so a fresh stack with no SMTP env vars does not
# burn BullMQ retry attempts. When unset/false (the DEFAULT), an
# undelivered email FAILS the job so BullMQ retries / dead-letters it —
# no silent green for an unsent email. It is an explicit operator
# opt-in and is NEVER derived from NODE_ENV. Leave UNSET in production.
# EMAIL_FALLBACK_NONFATAL=


# --- --with-contract-test ------------------------------------------------
# REQUIRES: compose/docker-compose.contract-test.yml
# Adds fixture-idp + seed + contract-test-runner for the API contract harness.
# Not in Helm chart (CONTEXT decision 1) — opt-in for CI / local contract runs.
# No BYOK envs required; the overlay is self-contained.


# === Phase 8 / Plan 01 — load-test rate-limit bypass ===
# LOAD-TEST-ONLY — disables BOTH Fastify @fastify/rate-limit AND Better
# Auth's built-in rate-limiter. MUST NOT be set in production. Used by
# docker-compose `load-test-mock` / `load-test-realistic` profiles so the
# 1000-VU k6 run can drive synthetic traffic from a single Mac IP without
# tripping the global IP-tier ceiling (600/min) inside the first second.
# Production deployments inherit the safe rate-limited posture by leaving
# this UNSET. The api logs a loud WARN banner on boot when the switch is
# on, so accidental production leaks are visible in operator dashboards.
# OPENWHISPR_DISABLE_RATE_LIMIT=1


# === Phase 68 — diarization adapter knobs ================================
# Endpoint URL, poll cadence/ceiling and local-Speaches model alias for the
# /v1/audio/diarization route + the pyannote.ai REST client. All OPTIONAL —
# unset means the bundled defaults below (no behavior change). Corporate
# operators behind an egress proxy or pointing at a pyannote mirror set
# PYANNOTE_BASE_URL; load-test profiles preloading a different Speaches
# model set SPEACHES_DIARIZATION_MODEL.
# PYANNOTE_BASE_URL=https://api.pyannote.ai
# PYANNOTE_POLL_INTERVAL_MS=1500
# PYANNOTE_POLL_CEILING_MS=300000
# SPEACHES_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1


# === Phase 68 — web-search adapter knobs =================================
# Upstream endpoint URLs and request timeouts for the Tavily / Yandex
# /api/agent/web-search adapters. All OPTIONAL — unset means the bundled
# defaults below (no behavior change). Operators behind an egress proxy, on
# a slow corporate link, or pointing at a regional Yandex mirror retune
# these without a code change.
# TAVILY_SEARCH_URL=https://api.tavily.com/search
# TAVILY_TIMEOUT_MS=5000
# YANDEX_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
# YANDEX_HEADERS_TIMEOUT_MS=5000
# YANDEX_BODY_TIMEOUT_MS=10000
