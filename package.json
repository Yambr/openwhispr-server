{
  "name": "openwhispr-server",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "prepare": "node tools/install-hooks.cjs",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "lint:english": "tsx tools/lint-english.ts",
    "lint:tdd": "tsx tools/lint-tdd.ts",
    "lint:rls": "tsx tools/lint-rls.ts",
    "lint:tenant-context": "tsx tools/lint-tenant-context.ts",
    "lint:ui-spec": "tsx tools/lint-ui-spec.ts",
    "lint:migrations": "tsx tools/lint-migrations.ts",
    "lint:compose-chart-parity": "tsx tools/lint-compose-chart-parity.ts",
    "lint:colocated-tests": "tsx tools/lint-colocated-tests.ts",
    "lint:phase-tag-comments": "tsx tools/lint-phase-tag-comments.ts",
    "lint:dockerfile-tls": "tsx tools/lint-dockerfile-tls.ts",
    "lint:no-dockerhub-pg-image": "tsx tools/lint-no-dockerhub-pg-image.ts",
    "test:lint-no-dockerhub-pg-image": "vitest run tools/lint-no-dockerhub-pg-image.test.ts --coverage --coverage.include=tools/lint-no-dockerhub-pg-image.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:gitleaks": "gitleaks detect --redact --config=.gitleaks.toml --no-git --no-banner",
    "lint:gitleaks:staged": "gitleaks protect --staged --redact --config=.gitleaks.toml --no-banner",
    "lint:no-env-branches": "tsx tools/lint-no-env-branches.ts",
    "test:lint-no-env-branches": "vitest run tools/lint-no-env-branches.test.ts --coverage --coverage.include=tools/lint-no-env-branches.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:no-suppressions": "tsx tools/lint-no-suppressions.ts",
    "test:lint-no-suppressions": "vitest run tools/lint-no-suppressions.test.ts --coverage --coverage.include=tools/lint-no-suppressions.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:no-hardcode": "tsx tools/lint-no-hardcode.ts",
    "test:lint-no-hardcode": "vitest run tools/lint-no-hardcode.test.ts --coverage --coverage.include=tools/lint-no-hardcode.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "changelog:extract": "tsx tools/changelog-extract.ts",
    "test:changelog-extract": "vitest run tools/changelog-extract.test.ts --coverage --coverage.include=tools/changelog-extract.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:changelog": "tsx tools/lint-changelog.ts CHANGELOG.md charts/openwhispr-server/Chart.yaml",
    "test:lint-changelog": "vitest run tools/lint-changelog.test.ts --coverage --coverage.include=tools/lint-changelog.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:shell-credential-interpolation": "tsx tools/lint-shell-credential-interpolation.ts",
    "test:lint-shell-credential-interpolation": "vitest run tools/lint-shell-credential-interpolation.test.ts --coverage --coverage.include=tools/lint-shell-credential-interpolation.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:prod-readiness": "tsx tools/lint-prod-readiness.ts --warn-only",
    "test:lint-prod-readiness": "vitest run tools/lint-prod-readiness.test.ts --coverage --coverage.include=tools/lint-prod-readiness.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:secret-shape-in-error": "tsx tools/lint-secret-shape-in-error.ts",
    "test:lint-secret-shape-in-error": "vitest run tools/lint-secret-shape-in-error.test.ts --coverage --coverage.include=tools/lint-secret-shape-in-error.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:no-plaintext-secret-columns": "tsx tools/lint-no-plaintext-secret-columns.ts",
    "test:lint-no-plaintext-secret-columns": "vitest run tools/__tests__/lint-no-plaintext-secret-columns.test.ts --coverage --coverage.include=tools/lint-no-plaintext-secret-columns.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:lockers": "pnpm lint:no-env-branches && pnpm lint:no-suppressions && pnpm lint:no-hardcode && pnpm lint:prod-readiness && pnpm lint:secret-shape-in-error && pnpm lint:shell-credential-interpolation && pnpm lint:no-plaintext-secret-columns",
    "lint:lockers-allowlist-diff": "tsx tools/lockers-allowlist-diff.ts",
    "test:lockers-allowlist-diff": "vitest run tools/lockers-allowlist-diff.test.ts --coverage --coverage.include=tools/lockers-allowlist-diff.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:gherkin-tags": "tsx tools/lint-gherkin-tags.ts",
    "lint:playwright-config": "tsx tools/lint-playwright-config.ts",
    "lint:steps-have-unit-tests": "tsx tools/lint-steps-have-unit-tests.ts",
    "lint:prod-edit-guard": "tsx tools/lint-no-prod-edit-with-test-only-pr.ts",
    "lint:coverage-floor": "tsx tools/lint-coverage-floor-per-phase.ts",
    "test:lint-gherkin-tags": "vitest run tools/lint-gherkin-tags.test.ts --coverage --coverage.include=tools/lint-gherkin-tags.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-playwright-config": "vitest run tools/lint-playwright-config.test.ts --coverage --coverage.include=tools/lint-playwright-config.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=80 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-steps-have-unit-tests": "vitest run tools/lint-steps-have-unit-tests.test.ts --coverage --coverage.include=tools/lint-steps-have-unit-tests.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-prod-edit-guard": "vitest run tools/lint-no-prod-edit-with-test-only-pr.test.ts --coverage --coverage.include=tools/lint-no-prod-edit-with-test-only-pr.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-coverage-floor": "vitest run tools/lint-coverage-floor-per-phase.test.ts --coverage --coverage.include=tools/lint-coverage-floor-per-phase.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-colocated-tests": "vitest run tools/lint-colocated-tests.test.ts --coverage --coverage.include=tools/lint-colocated-tests.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:migrate-tests": "vitest run tools/migrate-tests.test.ts --coverage --coverage.include=tools/migrate-tests.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "spdx:check": "tsx tools/spdx-header.ts audit",
    "spdx:fix": "tsx tools/spdx-header.ts fix",
    "test:spdx-header": "vitest run tools/__tests__/spdx-header.test.ts --coverage --coverage.include=tools/spdx-header.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=85 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-ui-spec": "vitest run tools/lint-ui-spec.test.ts --coverage --coverage.include=tools/lint-ui-spec.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-migrations": "vitest run tools/lint-migrations.test.ts --coverage --coverage.include=tools/lint-migrations.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-compose-chart-parity": "vitest run tools/lint-compose-chart-parity.test.ts --coverage --coverage.include=tools/lint-compose-chart-parity.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:compose-resources": "tsx tools/lint-compose-resources.ts",
    "test:lint-compose-resources": "vitest run tools/lint-compose-resources.test.ts --coverage --coverage.include=tools/lint-compose-resources.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:i18n-completeness": "pnpm --filter @openwhispr/api test:i18n-completeness",
    "test:upgrade-matrix-tools": "vitest run tools/seed-test-data.test.mjs tools/integrity-check.test.mjs --coverage --coverage.include=tools/seed-test-data.js --coverage.include=tools/integrity-check.js --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=70 --coverage.thresholds.functions=50 --coverage.thresholds.statements=90",
    "lint:skip-annotations": "tsx tools/lint-skip-annotations.ts",
    "test:lint-skip-annotations": "vitest run tools/__tests__/lint-skip-annotations.test.ts --coverage --coverage.include=tools/lint-skip-annotations.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:codemod-skip-annotations": "vitest run tools/__tests__/codemod-skip-annotations.test.ts --coverage --coverage.include=tools/codemod-skip-annotations.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:vitest-reporter-inheritance": "tsx tools/lint-vitest-reporter-inheritance.ts",
    "test:lint-vitest-reporter-inheritance": "vitest run tools/__tests__/lint-vitest-reporter-inheritance.test.ts --coverage --coverage.include=tools/lint-vitest-reporter-inheritance.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:test-evidence-projects-manifest": "vitest run tools/__tests__/test-evidence-projects-manifest.test.ts",
    "test:test-evidence-reporter": "vitest run tools/__tests__/test-evidence-reporter.test.ts --coverage --coverage.include=tools/test-evidence-reporter.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint:pre-push-test-evidence": "tsx tools/lint-pre-push-test-evidence.ts",
    "test:lint-pre-push-test-evidence": "vitest run tools/__tests__/lint-pre-push-test-evidence.test.ts --coverage --coverage.include=tools/lint-pre-push-test-evidence.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-lefthook-stdin-config": "vitest run tools/__tests__/lint-lefthook-stdin-config.test.ts",
    "test:all": "vitest run",
    "test:evidence": "vitest run",
    "test:evidence:check": "git rev-parse HEAD | xargs -I{} bash -c 'printf \"refs/heads/HEAD %s refs/heads/HEAD 0000000000000000000000000000000000000000\\n\" {}' | tsx tools/lint-pre-push-test-evidence.ts",
    "test:evidence:projects-self-test": "tsx tools/test-evidence-projects-self-test.ts",
    "test:test-evidence-projects-self-test": "vitest run tools/__tests__/test-evidence-projects-self-test.test.ts --coverage --coverage.include=tools/test-evidence-projects-self-test.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "test:contract": "pnpm --filter ./packages/contract-tests test",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @openwhispr/data exec tsx src/migrate.ts",
    "migrate:rollback": "pnpm --filter @openwhispr/data exec drizzle-kit drop",
    "stryker:sync-excludes": "tsx tools/stryker-sync-excludes.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@cucumber/cucumber": "12.9.0",
    "@playwright/test": "1.60.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testcontainers/postgresql": "11.14.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "25.6.2",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.0.0",
    "lefthook": "2.1.8",
    "pg": "8.21.0",
    "playwright-bdd": "8.5.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "ts-morph": "^28.0.0",
    "tsup": "8.5.1",
    "tsx": "latest",
    "typescript": "6.0.3",
    "undici": "7.25.0",
    "unified": "^11.0.5",
    "vitest": "4.1.5",
    "yaml": "^2.9.0"
  }
}
