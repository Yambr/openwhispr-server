{
  "name": "openwhispr-server",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "prepare": "node tools/install-hooks.cjs",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "lint:english": "tsx tools/lint-english.ts",
    "lint:tdd": "tsx tools/lint-tdd.ts",
    "lint:rls": "tsx tools/lint-rls.ts",
    "lint:tenant-context": "tsx tools/lint-tenant-context.ts",
    "lint:ui-spec": "tsx tools/lint-ui-spec.ts",
    "lint:migrations": "tsx tools/lint-migrations.ts",
    "lint:compose-chart-parity": "tsx tools/lint-compose-chart-parity.ts",
    "spdx:check": "tsx tools/spdx-header.ts audit",
    "spdx:fix": "tsx tools/spdx-header.ts fix",
    "test:spdx-header": "vitest run tools/__tests__/spdx-header.test.ts --coverage --coverage.include=tools/spdx-header.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-ui-spec": "vitest run tools/lint-ui-spec.test.ts --coverage --coverage.include=tools/lint-ui-spec.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-migrations": "vitest run tools/lint-migrations.test.ts --coverage --coverage.include=tools/lint-migrations.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:lint-compose-chart-parity": "vitest run tools/lint-compose-chart-parity.test.ts --coverage --coverage.include=tools/lint-compose-chart-parity.ts --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:i18n-completeness": "pnpm --filter @openwhispr/api test:i18n-completeness",
    "test:upgrade-matrix-tools": "vitest run tools/seed-test-data.test.mjs tools/integrity-check.test.mjs --coverage --coverage.include=tools/seed-test-data.js --coverage.include=tools/integrity-check.js --coverage.exclude= --coverage.all=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=70 --coverage.thresholds.functions=50 --coverage.thresholds.statements=90",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:contract": "pnpm --filter ./packages/contract-tests test",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @openwhispr/data exec tsx src/migrate.ts",
    "migrate:rollback": "pnpm --filter @openwhispr/data exec drizzle-kit drop"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@biomejs/biome": "2.4.14",
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@cucumber/cucumber": "12.8.2",
    "@playwright/test": "1.60.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testcontainers/postgresql": "11.14.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "25.6.2",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.5",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.0.0",
    "lefthook": "2.1.6",
    "pg": "8.20.0",
    "playwright-bdd": "8.5.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "ts-morph": "^28.0.0",
    "tsup": "8.5.1",
    "tsx": "latest",
    "typescript": "6.0.3",
    "undici": "7.25.0",
    "unified": "^11.0.5",
    "vitest": "4.1.5",
    "yaml": "^2.8.4"
  }
}
