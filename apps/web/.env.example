# Internal URL the Next.js server uses for server-side fetches against apps/api.
# Same docker-compose network; service name "api" on port 3000.
INTERNAL_API_URL=http://api:3000

# Public base URL of the Grafana dashboard linked from /admin/observability (A2).
NEXT_PUBLIC_GRAFANA_BASE_URL=

# Public base URL of the Tempo UI (traces) linked from /admin/observability.
NEXT_PUBLIC_TEMPO_BASE_URL=

# Public base URL of the Mimir UI (metrics) linked from /admin/observability.
NEXT_PUBLIC_MIMIR_BASE_URL=

# Public base URL of the Loki UI (logs) linked from /admin/observability.
NEXT_PUBLIC_LOKI_BASE_URL=

# Comma-separated list of OIDC provider slugs surfaced on /sign-in (U1).
# Must match providers configured server-side in apps/api/src/auth.ts.
NEXT_PUBLIC_OIDC_PROVIDERS=google,github,oidc

# scaffold validated: typecheck OK, build OK, /api/health 200 OK, headers verified
