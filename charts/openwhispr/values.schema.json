{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openwhispr chart values",
  "type": "object",
  "definitions": {
    "startupProbe": {
      "type": "object",
      "description": "Phase 20 / SR-20.3 — per-workload startupProbe budget. failureThreshold × periodSeconds = boot budget in seconds.",
      "properties": {
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "topologySpread": {
      "type": "object",
      "description": "Phase 20 / SR-20.4 — per-workload topologySpreadConstraints. Set enabled=false to omit the block on single-node clusters.",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "topologyKey": { "type": "string", "minLength": 1 },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": ["DoNotSchedule", "ScheduleAnyway"]
        }
      },
      "additionalProperties": false
    },
    "securityContextFull": {
      "type": "object",
      "description": "Phase 20 / SR-20.5 — full-hardening per-workload securityContext (pod + container subobjects). Used by api/web/worker.",
      "properties": {
        "pod": {
          "type": "object",
          "properties": {
            "runAsNonRoot": { "type": "boolean" },
            "runAsUser": { "type": "integer", "minimum": 0 },
            "runAsGroup": { "type": "integer", "minimum": 0 },
            "fsGroup": { "type": "integer", "minimum": 0 },
            "seccompProfile": {
              "type": "object",
              "properties": {
                "type": { "type": "string" }
              }
            }
          }
        },
        "container": {
          "type": "object",
          "properties": {
            "readOnlyRootFilesystem": { "type": "boolean" },
            "allowPrivilegeEscalation": { "type": "boolean" },
            "capabilities": {
              "type": "object",
              "properties": {
                "drop": { "type": "array", "items": { "type": "string" } },
                "add": { "type": "array", "items": { "type": "string" } }
              }
            },
            "seccompProfile": {
              "type": "object",
              "properties": {
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "secrets": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["helm-values", "eso"]
        },
        "external": {
          "type": "object",
          "properties": {
            "storeRef": { "type": "string" },
            "storeKind": {
              "type": "string",
              "enum": ["SecretStore", "ClusterSecretStore"]
            },
            "path": { "type": "string" },
            "refreshInterval": { "type": "string" }
          }
        },
        "litellmMasterKey": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] },
          "description": "LiteLLM master key. Must be >= 32 chars in helm-values mode. Empty allowed only when secrets.mode=eso."
        },
        "openrouterApiKey": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "openaiApiKey": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "pyannoteApiKey": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "hfToken": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "postgresOwnerPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "pgbouncerAdminPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "betterAuthSecret": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "postgresAppPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] },
          "description": "Finding 09.1-F22 — POSTGRES_APP_PASSWORD demanded by check-default-secrets.ts."
        },
        "valkeyPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "minioRootPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "traefikAdminPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "grafanaAdminPassword": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        },
        "masterKek": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] },
          "description": "Master KEK — must base64url-decode to 32 bytes (EnvKeyProvider check)."
        },
        "backupAgeIdentity": {
          "type": "string",
          "not": { "enum": ["CHANGE_ME", "changeme"] }
        }
      },
      "required": ["mode"]
    },
    "postgres": {
      "type": "object",
      "properties": {
        "imageName": {
          "type": "string",
          "pattern": "^.+:17\\.[0-9]+.*$",
          "description": "Must pin Postgres major version 17. CNPG default catalog ships PG 18 — refusing to install on non-17 image (T-09-02)."
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "pooler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "type": {
          "type": "string",
          "enum": ["rw", "ro"]
        },
        "poolMode": {
          "type": "string",
          "enum": ["session", "transaction", "statement"]
        },
        "maxClientConn": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "defaultPoolSize": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "reservePoolSize": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "bundledAi": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "architecture": {
          "type": "string",
          "enum": ["standalone", "replication"]
        }
      }
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["standalone", "distributed"]
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "embedded": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "collector": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "lgtm": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collector": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["collector"]
          },
          "then": {
            "properties": {
              "lgtm": {
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "minLength": 8,
                    "pattern": "^https?://"
                  }
                },
                "required": ["endpoint"]
              }
            },
            "required": ["lgtm"]
          }
        }
      ]
    },
    "api": {
      "type": "object",
      "properties": {
        "startupProbe": { "$ref": "#/definitions/startupProbe" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "securityContext": { "$ref": "#/definitions/securityContextFull" }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "startupProbe": { "$ref": "#/definitions/startupProbe" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "securityContext": { "$ref": "#/definitions/securityContextFull" }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "startupProbe": { "$ref": "#/definitions/startupProbe" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "securityContext": { "$ref": "#/definitions/securityContextFull" }
      }
    },
    "host": {
      "type": "object",
      "properties": {
        "api": { "type": "string", "minLength": 1 },
        "web": { "type": "string", "minLength": 1 }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "apiSecretName": { "type": "string", "minLength": 1 },
        "webSecretName": { "type": "string", "minLength": 1 }
      }
    },
    "certManager": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "clusterIssuer": { "type": "string", "minLength": 1 },
        "bundled": {
          "type": "boolean",
          "default": false,
          "description": "Phase 17 — opt-in to the bundled jetstack/cert-manager sub-chart (default OFF for brownfield safety)."
        },
        "issuerKind": {
          "type": "string",
          "enum": ["ClusterIssuer", "Issuer"],
          "default": "ClusterIssuer",
          "description": "Phase 17 — Drives templates/issuer.yaml body kind and templates/certificate-{api,web}.yaml issuerRef.kind."
        },
        "renderIssuer": {
          "type": "boolean",
          "default": false,
          "description": "Phase 17 — render an (Cluster)Issuer body from this chart (most operators apply their issuer externally)."
        },
        "acmeEmail": {
          "type": "string",
          "default": "",
          "description": "Phase 17 — REQUIRED at render time when renderIssuer=true. ACME account contact email per RFC 8555 §7.3."
        },
        "acmeStaging": {
          "type": "boolean",
          "default": false,
          "description": "Phase 17 — flip true to use the Let's Encrypt staging endpoint."
        },
        "installCRDs": {
          "type": "boolean",
          "default": true,
          "description": "Phase 17 — passthrough to the bundled cert-manager sub-chart's installCRDs value (only meaningful when bundled=true)."
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "className": { "type": "string" },
        "preflightCheck": { "type": "boolean" },
        "preflightTraefikAdminUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "trustedIPs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "litellm": {
      "type": "object",
      "properties": {
        "embedded": { "type": "boolean" },
        "externalBaseUrl": { "type": "string" },
        "startupProbe": { "$ref": "#/definitions/startupProbe" },
        "topologySpread": { "$ref": "#/definitions/topologySpread" },
        "securityContext": { "$ref": "#/definitions/securityContextFull" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "embedded": { "const": false } },
            "required": ["embedded"]
          },
          "then": {
            "properties": {
              "externalBaseUrl": {
                "type": "string",
                "minLength": 8,
                "pattern": "^https://"
              }
            },
            "required": ["externalBaseUrl"]
          }
        }
      ]
    }
  }
}
