# OpenWhispr Server — environment template.
# Run tools/bootstrap.sh (Plan 02) to populate every PLACEHOLDER value with
# strong random secrets and write a gitignored .env. The bootstrap script
# refuses to start the stack if any value still matches the deny-list
# (changeme, password, admin, sk-1234, secret, empty string).

# Postgres roles (D-15): owner runs migrations with BYPASSRLS; app role
# is what PgBouncer/Fastify connect as and is subject to RLS.
POSTGRES_OWNER_USER=openwhispr_owner
POSTGRES_OWNER_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE
POSTGRES_APP_USER=openwhispr_app
POSTGRES_APP_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE
POSTGRES_DB=openwhispr

# PgBouncer admin (queries the special `pgbouncer` admin database).
PGBOUNCER_ADMIN_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Valkey (Redis) auth.
VALKEY_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE
# Phase 03 / CR-01 fix — explicit Valkey URL for the api container's
# diarization idempotency cache. docker-compose interpolates ${VALKEY_PASSWORD}
# so this default works against the bundled valkey service. Override only
# when pointing the api at an external Valkey/Redis cluster.
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0

# MinIO root credentials (D-27/D-28). Single bucket `openwhispr`,
# tenant-scoped via key prefix `tenants/<tenant-uuid>/...`.
MINIO_ROOT_USER=openwhispr
MINIO_ROOT_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Traefik dashboard auth (Phase 9 hardens; insecure dashboard in v1 dev).
TRAEFIK_ADMIN_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Grafana admin login.
GRAFANA_ADMIN_PASSWORD=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# KEK envelope encryption (D-11): root key encryption key. Per-row DEKs
# are wrapped with this. Rotation re-wraps DEKs without re-encrypting
# payload.
MASTER_KEK=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Backup encryption identity (age). Used by `make backup` / `make restore`.
BACKUP_AGE_IDENTITY=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Better Auth signing secret (Phase 2 wires the actual auth server).
BETTER_AUTH_SECRET=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# Key provider selector (env | vault | kms). v1 ships env; vault and kms
# adapters are stubs through Phase 9.
OPENWHISPR_KEY_PROVIDER=env

# Connection strings. App connects via PgBouncer; migrations connect
# directly to Postgres as the owner role (D-15). The migrate runner
# refuses to run if DATABASE_URL_OWNER hostname contains "pgbouncer"
# (CONTAINER-A1) — DDL through transaction-mode pooling is unsafe.
DATABASE_URL=postgres://openwhispr_app:${POSTGRES_APP_PASSWORD}@pgbouncer:5432/openwhispr?sslmode=disable
DATABASE_URL_OWNER=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/openwhispr?sslmode=disable

# ---------------------------------------------------------------------------
# Phase 3 — LiteLLM Proxy + AI provider keys
# ---------------------------------------------------------------------------

# LiteLLM master key — bearer auth between Fastify api and the LiteLLM
# sidecar. bootstrap.sh generates a strong random secret on first run.
LITELLM_MASTER_KEY=PLACEHOLDER_BOOTSTRAP_WILL_REPLACE

# LiteLLM database URL (separate `litellm` database in the same Postgres
# cluster as `openwhispr`). The migrate runner ensures this database
# exists on EVERY `docker compose up` (HIGH-1; non-destructive auto-create).
LITELLM_DATABASE_URL=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/litellm?sslmode=disable

# Postgres admin URL used by the migrate runner's ensureLitellmDatabase()
# helper to issue `CREATE DATABASE litellm IF NOT EXISTS`. Connects DIRECT
# to postgres:5432 (NOT pgbouncer — DDL through transaction-mode pooling
# is unsafe). Defaults to the owner credentials on the maintenance
# `postgres` database; the owner role has CREATEDB granted in
# packages/data/migrations/init/00-roles.sql.tpl.
POSTGRES_ADMIN_URL=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/postgres

# AI provider keys — leave blank to enable 503-envelope responses on the
# corresponding routes (operator opts in to each provider). bootstrap.sh
# does NOT generate these; operators paste their own.

# OPENROUTER_API_KEY powers /api/reason (D-10 LLM lineup).
# Required for: load-test-realistic (drives /api/reason + /api/agent/stream).
OPENROUTER_API_KEY=
# GROQ_API_KEY powers /api/transcribe (Whisper-large-v3, D-11 bundled default).
# Unused under load-test-realistic — Speaches replaces the bundled upstream
# (08.5 / compose/litellm/litellm_config.realistic.yaml).
GROQ_API_KEY=
# OPENAI_API_KEY powers WSS /v1/realtime (OpenAI Realtime API direct, D-12).
# Without it the bundled `gpt-realtime` model entry returns close-with-error
# on WSS upgrade — Fastify proxy itself still mounts. Verified accessible
# 2026-05-10 (14 realtime models including gpt-realtime GA).
# Required for: load-test-realistic (k6 realtime-ws flow hits real OpenAI).
OPENAI_API_KEY=

# === Variant C only — local Speaches with pyannote-master build ===
# Plan 11-01 relocated the HF_TOKEN block here so Variant A (default OSS
# quickstart with hosted providers via LiteLLM) operators never have to
# populate a key their installation never uses. Only set HF_TOKEN if you
# are running the Variant C compose overlay (Plan 11-03) that boots a
# local Speaches container needing gated Hugging Face weights.
#
# HF_TOKEN powers the Speaches container's pyannote-3.1 +
# pyannote/speaker-diarization-community-1 weight download (gated HF
# repos). Phase 08.5-01 wires Speaches's PRELOAD_MODELS env to download
# both models at boot. Without HF_TOKEN the first boot fails the
# pyannote download with a 403 and diarization endpoints surface a 503.
# Required for: load-test-realistic (pyannote gated weights download).
HF_TOKEN=
# === End Variant C only block ===

# PYANNOTE_API_KEY powers /v1/audio/diarization. Per D-07 REVISED this is
# consumed by the Fastify route (apps/api/src/routes/diarization.ts) which
# orchestrates pyannote.ai's 4-step async API (presigned upload → diarize
# → poll). It is NOT forwarded to the litellm container — bundled mode
# does not use LiteLLM for diarization.
PYANNOTE_API_KEY=

# Phase 08.6 — local Speaches diarization endpoint override. When set,
# /v1/audio/diarization bypasses the pyannote.ai async API entirely and
# posts multipart (file, model=pyannote/speaker-diarization-community-1)
# synchronously to this URL. Used by the docker-compose.load-test.realistic
# profile (auto-wired to http://speaches:8000 there). Leave UNSET in
# production self-host — the route falls back to the pyannote.ai async
# branch consuming PYANNOTE_API_KEY above.
SPEACHES_DIARIZATION_URL=

# Override the bundled LiteLLM with a corporate proxy (LITELLM-05).
# When set, all AI traffic routes here instead of http://litellm:4000.
# Use http://litellm:4000 (default) or e.g. https://litellm.corp.example.com.
# Corporate operators may also place a single-hop pyannote endpoint behind
# their own LiteLLM via pass_through_endpoints — bundled mode does not.
LITELLM_BASE_URL=http://litellm:4000

# Phase 03 Plan 08 — apps/worker reads LiteLLM_SpendLogs DIRECT from
# postgres:5432 (NOT pgbouncer — Pitfall #9, cross-DB query semantics
# break through transaction-mode pooling). Defaults to the same owner
# credentials used by the migrate runner against the `litellm` database.
# Override only if your LiteLLM uses a separate Postgres cluster.
# LITELLM_READ_DATABASE_URL=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/litellm

# ---------------------------------------------------------------------------
# Phase 2 Plan 02 additions
# ---------------------------------------------------------------------------

# SMTP / email (D-26). When SMTP_HOST is unset, email features are
# disabled and accounts auto-verify (preserves the < 5 min first-launch
# SLO for OSS operators who haven't configured SMTP). For dev, set
# SMTP_HOST=mailpit and SMTP_PORT=1025 and bring up the `dev` profile.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@openwhispr.local

# OAuth protocol-redirect scheme (AUTH-02). The desktop client passes
# the scheme via callbackURL; the server echoes it back exactly.
# Built-in `openwhispr`, `openwhispr-dev`, `openwhispr-staging` are
# always allowed via scheme-allowlist.ts BUILTIN_SCHEMES (no need to
# repeat them here). Phase 02.17 (D-01) extended this var to accept a
# comma-separated list so contract-test profiles can register multiple
# custom schemes (e.g. `mycorp-whispr` for oauth-redirect.test.ts).
# Production operators set this to their own scheme(s).
OPENWHISPR_PROTOCOL=mycorp-whispr

# Public URLs. Behind Traefik on a self-host single-VM these default to
# api.localhost. Cloud / corporate operators override.
OPENWHISPR_API_URL=https://api.localhost
AUTH_URL=https://api.localhost

# Phase 15 / Plan 02 (STRUCT-05) — Better Auth trustedOrigins env extension.
# Comma-separated list of additional origins admitted by Better Auth's CSRF
# gate. The canonical dev split-host topology has the API at
# https://api.localhost AND the Next.js web app at https://web.localhost
# (see compose/traefik/dynamic.dev.yml). Both must be admitted so the
# browser at web.localhost can POST to api.localhost without CSRF rejection.
# http forms are included for non-TLS dev (rare; mkcert is the default).
AUTH_TRUSTED_ORIGINS_EXTRA=https://web.localhost,https://api.localhost,http://web.localhost,http://api.localhost

# Optional OIDC upstream (Plan 01 D-02 — env-gated).
#
# Phase 02.13: docker-compose.yml api service provides defaults pointing
# at the contract-test `fixture-idp` service via `${VAR:-default}`
# substitution. Compose v2.x treats `.env` empty string as "set" (NOT
# unset) for `:-` substitution purposes, which would block the defaults
# from applying. Therefore we OMIT these keys from .env.example entirely
# — operators wiring real OIDC providers (Google, Azure, Keycloak)
# add them to their own `.env` to override the fixture-idp defaults.
#
# Examples (uncomment + fill in to override):
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# Phase 4 — Streaming + Realtime (WIRE-13)
# ---------------------------------------------------------------------------
# AssemblyAI streaming token mint (POST /api/streaming-token, D-14).
# Leave blank to disable the route — calls return 503 with the
# operator-actionable "AssemblyAI not configured" envelope.
ASSEMBLYAI_API_KEY=
# Override the upstream `expires_in_seconds` query value (default 60s,
# AssemblyAI hard ceiling 600s). Reduce to 30 for high-churn fleets.
ASSEMBLYAI_TOKEN_TTL=60

# Deepgram Grant Token mint (POST /api/deepgram-streaming-token, D-15, WIRE-14).
# Leave blank to disable the route — calls return 503 with the
# operator-actionable "Deepgram not configured" envelope.
DEEPGRAM_API_KEY=
# Override the upstream `ttl_seconds` body field (default 30s, no provider
# ceiling enforced — keep tight for least-privilege ephemerality).
DEEPGRAM_TOKEN_TTL=30

# ---------------------------------------------------------------------------
# Phase 5 — Web Search (WIRE-08)
# ---------------------------------------------------------------------------
# Registry-based multi-provider adapter. Selection is per-deployment, not
# per-request — the desktop client does not pass a provider preference in
# the wire contract. Unknown provider name → fatal at boot.
#   tavily — OSS-default; cleanest LLM-tuned snippets.
#   yandex — RU-region; Yandex AI Studio Search API.
WEB_SEARCH_PROVIDER=tavily

# Tavily Search API (https://tavily.com). Leave blank to disable when
# WEB_SEARCH_PROVIDER=tavily — calls return 503 with the operator-actionable
# "Tavily not configured" envelope.
TAVILY_API_KEY=

# Yandex Search API v2 (Yandex Cloud).
# Endpoint: POST https://searchapi.api.cloud.yandex.net/v2/web/search
# Docs:     https://yandex.cloud/en/docs/search-api/
#
# STATUS — LIVE adapter (replaces the wire-shape stub originally shipped
# in Plan 03). Setting BOTH `YANDEX_SEARCH_API_KEY` and
# `YANDEX_SEARCH_FOLDER_ID` enables the adapter — there is no separate
# feature flag. Region selection is driven per request (defaults to 'ru');
# region tuples map as ru→{SEARCH_TYPE_RU,225,LOCALIZATION_RU},
# tr→{SEARCH_TYPE_TR,983,LOCALIZATION_TR}, en→{SEARCH_TYPE_COM,84,LOCALIZATION_EN}.
#
# Required when WEB_SEARCH_PROVIDER=yandex:
# - YANDEX_SEARCH_API_KEY: the secret returned at key creation (shown once).
# - YANDEX_SEARCH_API_KEY_ID: the long-lived key id paired with the secret
#   (informational; the adapter authenticates with the secret only).
# - YANDEX_SEARCH_FOLDER_ID: Yandex Cloud folder id (b1g... prefix). The
#   legacy `YANDEX_FOLDER_ID` is still accepted as a fallback for
#   backward-compatibility with operators who authored .env from the
#   pre-live template.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_API_KEY_ID=
YANDEX_SEARCH_FOLDER_ID=
# Legacy alias (read only when YANDEX_SEARCH_FOLDER_ID is unset):
# YANDEX_FOLDER_ID=

# -----------------------------------------------------------------------------
# Phase 5 / Plan 04 — settings defaults (D-18, D-19, D-20).
#
# These power the bottom rung of the resolution chain used by
# /api/stt-config (WIRE-11) and /api/note-recording-config (WIRE-12):
#
#   user_settings.<field> → tenant_settings.<field> → env defaults below
#
# Tenant + user overrides land in v1 only via the AFTER INSERT seed
# trigger on `tenants` (Plan 01). Mutation paths are deferred to Phase 7
# per D-31, so for v1 self-hosters these env values are what every fresh
# tenant gets back.
#
# `availableProviders` in the /api/stt-config response is NOT read from
# settings tables; it is computed at request time from whichever of
# OPENAI_API_KEY / GROQ_API_KEY / ASSEMBLYAI_API_KEY / DEEPGRAM_API_KEY
# are set — keys above in this file control that list directly (D-19).
# -----------------------------------------------------------------------------
STT_DEFAULT_MODEL=whisper-1
STT_DEFAULT_LANGUAGE=auto
NOTE_RECORDING_MAX_DURATION_SECONDS=7200
NOTE_RECORDING_SAMPLE_RATE_HZ=16000
NOTE_RECORDING_ALLOWED_FORMATS=webm,ogg,wav,m4a
NOTE_RECORDING_DIARIZATION_ENABLED=true

# -----------------------------------------------------------------------------
# Phase 6 / Plan 06 — SSRF defense (SCALE-04, D-S1..S6).
#
# Every outbound HTTP/HTTPS request from the API process is gated by a
# process-wide undici dispatcher (apps/api/src/lib/ssrf-dispatcher.ts).
# The gate performs single-resolve-then-connect-by-IP (closes the
# DNS-rebinding TOCTOU window) and validates every resolved IP against
# a hardcoded 13-entry block-list (RFC1918 + loopback + link-local incl.
# AWS IMDSv1 169.254.169.254 + IPv6 ULA + AWS IMDS v6).
#
# OUTBOUND_ALLOWED_HOSTS — default-deny allow-list. Bare hostnames match
#   exactly; `*.suffix` entries match one-or-more left labels.
# OUTBOUND_PRIVATE_HOST_ALLOWLIST — hostnames (typically docker-compose
#   service names) permitted to resolve to RFC1918 addresses inside the
#   compose network.
# OUTBOUND_ALLOW_LOOPBACK — `1` permits 127.0.0.1 / ::1 ONLY when
#   NODE_ENV != 'production'. Used by local dev and the test harness.
# OUTBOUND_SSRF_MODE — `enforce` (default) blocks + 502s; `warn` lets
#   the request proceed but still emits a `security.ssrf_blocked` audit
#   row tagged `payload.mode='warn'` (rollout / observability mode).
# -----------------------------------------------------------------------------
OUTBOUND_ALLOWED_HOSTS=openrouter.ai,api.tavily.com,search-api.aistudio.yandex.ru,api.pyannote.ai,litellm,speaches,mailpit
OUTBOUND_PRIVATE_HOST_ALLOWLIST=litellm,speaches,mailpit,valkey,postgres,pgbouncer
OUTBOUND_ALLOW_LOOPBACK=0
OUTBOUND_SSRF_MODE=enforce

# -----------------------------------------------------------------------------
# Phase 6 / Plan 06-09 — anti-abuse rate-limit matrix (SCALE-04, D-RL1..3).
#
# Layered policy: a per-IP global ceiling protects against DoS, a per-route
# user-tier counter protects against authenticated-user abuse. Default
# values match the D-RL2 matrix; override to retune without code changes
# (Phase 8 k6 calibration target).
#
# All values are positive integers (requests per minute). Empty / unset =
# inherit the default.
# -----------------------------------------------------------------------------
# Global IP-tier ceiling (DoS shield, every route except probes).
RATE_LIMIT_GLOBAL_IP_CEILING=600

# Global user-tier per-route ceiling. Defaults to 60/min/route when unset
# (apps/api/src/plugins/rate-limit.ts). The per-route matrix below still
# applies stricter values on a per-route basis; this is the catch-all
# ceiling for routes not explicitly listed in `routes_to_limits` below.
# Test stacks raise this to effectively-disabled values when running the
# Playwright suite under a single fixture user.
# RATE_LIMIT_GLOBAL_USER_MAX=60

# Pre-auth abuse target (IP-only).
RATE_LIMIT_AUTH_SIGNIN_IP=10
RATE_LIMIT_AUTH_SIGNUP_IP=10
RATE_LIMIT_AUTH_FORGOT_IP=10

# Polling carve-out — composite (IP,email); Phase 2 D-* preserved.
RATE_LIMIT_VERIFICATION_STATUS=30

# Poll-tolerant lightweight reads (/api/usage, /api/me, /api/tenants/current).
RATE_LIMIT_LIGHTWEIGHT_USER=120
RATE_LIMIT_LIGHTWEIGHT_IP=600

# Expensive endpoints.
RATE_LIMIT_TRANSCRIBE_USER=20
RATE_LIMIT_TRANSCRIBE_IP=60
RATE_LIMIT_REASON_USER=30
RATE_LIMIT_REASON_IP=90
RATE_LIMIT_AGENT_STREAM_USER=10
RATE_LIMIT_AGENT_STREAM_IP=30
RATE_LIMIT_WEB_SEARCH_USER=30
RATE_LIMIT_WEB_SEARCH_IP=90

# CRUD.
RATE_LIMIT_CRUD_WRITE_USER=60
RATE_LIMIT_CRUD_WRITE_IP=300
RATE_LIMIT_CRUD_READ_USER=120
RATE_LIMIT_CRUD_READ_IP=600
RATE_LIMIT_CRUD_BATCH_USER=20
RATE_LIMIT_CRUD_BATCH_IP=60

# Sensitive — key minting.
RATE_LIMIT_KEYS_CREATE_USER=5
RATE_LIMIT_KEYS_CREATE_IP=20
RATE_LIMIT_KEYS_OTHER_USER=30
RATE_LIMIT_KEYS_OTHER_IP=90

# Admin console.
RATE_LIMIT_ADMIN_USER=60
RATE_LIMIT_ADMIN_IP=300

# -----------------------------------------------------------------------------
# Phase 07.1 — Web app (@openwhispr/web)
# -----------------------------------------------------------------------------
# Traefik basic-auth gate on every /admin/* route (D-ADMIN-1). Web does NOT
# enforce admin role at the application layer — auth is resolved at the edge
# by the `admin-basicauth` Traefik middleware declared in docker-compose.yml.
#
# Format: comma-separated htpasswd entries — `user:hash,user:hash,...`.
# Bcrypt is recommended (start with $2y$ or $2a$); apr1 (MD5) is accepted by
# Traefik but cryptographically weaker — do NOT use in production.
#
# Generate a bcrypt entry with htpasswd from apache-tools / httpd-tools:
#   htpasswd -nbB admin "<plaintext-password>"
#
# CRITICAL: docker-compose interpolates `$` characters in env values. A raw
# bcrypt hash like `$2y$05$abc...` will be mangled (compose tries to expand
# $2y, $05, etc.). You MUST escape every `$` as `$$` when storing the value
# in `.env`. Compose then passes the un-escaped string through to Traefik.
#
# Example:
#   htpasswd output:  admin:$2y$05$abcdefghij...
#   .env value:       ADMIN_BASIC_AUTH_USERS=admin:$$2y$$05$$abcdefghij...
#
# Multiple users — separate with `,`:
#   ADMIN_BASIC_AUTH_USERS=alice:$$2y$$05$$...,bob:$$2y$$05$$...
#
# Convention (D-ADMIN-2): the first registered end-user's email is the
# expected admin identity, but no code path enforces this — operators pick
# whatever credentials they want.
ADMIN_BASIC_AUTH_USERS=

# Observability deep-links surfaced on /admin/observability (A2). Empty
# defaults render a destructive "configure NEXT_PUBLIC_GRAFANA_BASE_URL"
# Alert. Set per environment.
#
# CRITICAL (Phase 07.1 / Plan 13.3): these are NEXT_PUBLIC_* envs. Next.js
# inlines them into the client JS bundle at BUILD time, not at runtime.
# The `web` service in docker-compose.yml passes them through `build.args`
# into the apps/web/Dockerfile, which lifts them into ENV before
# `pnpm --filter @openwhispr/web build`. CHANGING these values requires
# `docker compose build web` (NOT just `docker compose up`).
NEXT_PUBLIC_GRAFANA_BASE_URL=
NEXT_PUBLIC_TEMPO_BASE_URL=
NEXT_PUBLIC_MIMIR_BASE_URL=
NEXT_PUBLIC_LOKI_BASE_URL=

# === Phase 07.1 / Plan 13.2 — Playwright e2e switches ===
# TEST-STACK ONLY. Production deployments MUST leave these unset.
#
# Phase 41 / Plan 41-c (HI-2) — PLAYWRIGHT_DISABLE_SSR_PREFETCH removed.
# The runtime env branch in 5 production RSC pages was deleted; setting
# the var has no effect. Loading-state e2e specs that relied on it are
# tracked in .planning/phases/41-residual-high-sweep/41-c-DEFERRED.md.
#
# OPENWHISPR_DISABLE_EMAIL_ENUMERATION_PROTECTION=1
#   Opts the apps/api Better Auth instance out of the anti-enumeration
#   synthetic-success response on duplicate sign-up. With
#   requireEmailVerification:true (our prod default), BA 1.6.9 hides
#   USER_ALREADY_EXISTS from unauthenticated clients to prevent account
#   enumeration. Setting this var to "1" makes the dup case throw the
#   canonical USER_ALREADY_EXISTS error, which the desktop client and the
#   U2 Playwright spec rely on. Production deployments inherit the safe
#   anti-enumeration behaviour by leaving this UNSET.
OPENWHISPR_DISABLE_EMAIL_ENUMERATION_PROTECTION=

# === Phase 8 / Plan 01 — load-test rate-limit bypass ===
# LOAD-TEST-ONLY — disables BOTH Fastify @fastify/rate-limit AND Better
# Auth's built-in rate-limiter. MUST NOT be set in production. Used by
# docker-compose `load-test-mock` / `load-test-realistic` profiles so the
# 1000-VU k6 run can drive synthetic traffic from a single Mac IP without
# tripping the global IP-tier ceiling (600/min) inside the first second.
# Production deployments inherit the safe rate-limited posture by leaving
# this UNSET. The api logs a loud WARN banner on boot when the switch is
# on, so accidental production leaks are visible in operator dashboards.
# OPENWHISPR_DISABLE_RATE_LIMIT=1

# === Phase 8.1 / Plan 01 — load-test forensic-capture escape hatch ===
# LOAD-TEST-ONLY — when set, tools/load-test/scripts/run.sh leaves the
# entire load-test stack RUNNING after k6 exits (even on threshold failure)
# so the operator can capture api/mock-litellm/pgbouncer logs before tearing
# the stack down by hand. Default behaviour is to tear down on every exit
# via the trap. MUST NOT be set in production / CI — a leaked stack pins
# 16+ host ports and ≈4 GB RAM for the developer Mac on every run.
# OPENWHISPR_LOADTEST_KEEP_STACK=1

# Comma-separated OIDC provider slugs surfaced as sign-in/sign-up buttons
# (U1 / U2). Controls UI visibility only — actual OIDC config lives in
# apps/api env vars per Phase 2 PROVIDER-03 (OIDC_ISSUER_URL, etc.).
NEXT_PUBLIC_OIDC_PROVIDERS=google,github,oidc
