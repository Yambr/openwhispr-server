{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["html", "clear-text", "progress"],
  "mutate": [
    "apps/api/src/**/*.ts",
    "packages/auth/src/**/*.ts",
    "packages/data/src/**/*.ts",
    "packages/litellm-client/src/**/*.ts",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/*.gen.ts"
  ],
  "_ignorePatterns_note": "Source-ASSERTION tests (readFileSync a mutated src/** file + toMatch/toContain its text) break in Stryker's dry run: instrumentation rewrites the literal tokens they grep for, the dry run fails, and Stryker aborts before testing any mutant. They are lint-class, not behavior tests, so they are removed from the Stryker sandbox here (they still run + gate under `pnpm test`). `.claude` drops local agent worktrees that pollute the sandbox. Completeness guarded by tools/lint-stryker-source-assertion-excludes.test.ts. fix 260530-rqk.",
  "ignorePatterns": [
    ".claude",
    "apps/api/tests/unit/__tests__/boot-order.test.ts",
    "apps/api/tests/unit/__tests__/fastify-request-types.test.ts",
    "apps/api/tests/unit/__tests__/no-tenant-plugin-regression.test.ts",
    "apps/api/tests/unit/auth.test.ts",
    "apps/api/tests/unit/boot-refusal.test.ts",
    "apps/api/tests/unit/i18n/__tests__/i18n-completeness.test.ts",
    "apps/api/tests/unit/lib/no-console-in-bootstrap.test.ts",
    "apps/api/tests/unit/lib/redact-url-bootstrap-usage.test.ts",
    "apps/api/tests/unit/lib/sse-parser.test.ts",
    "apps/api/tests/unit/lib/token-rotation-doc-truth.test.ts",
    "apps/api/tests/unit/otel-bootstrap.test.ts",
    "apps/api/tests/unit/plan-52-04b-routes-cascade.test.ts",
    "apps/api/tests/unit/plan-52-05-auth-typecheck.test.ts",
    "apps/api/tests/unit/routes/__tests__/setup-admin-auth-bypass.test.ts",
    "apps/api/tests/unit/routes/agent/plan-51-12tx4-stream-disconnect-destroy.test.ts",
    "apps/api/tests/unit/routes/agent/plan-52-06-stream-zod-drift.test.ts",
    "apps/api/tests/unit/routes/agent/stream-wr-03-04.test.ts",
    "apps/api/tests/unit/routes/agent/stream.test.ts",
    "apps/api/tests/unit/routes/agent/web-search-envvar-label.test.ts",
    "apps/api/tests/unit/routes/conversations/messages-role-contract.test.ts",
    "apps/api/tests/unit/routes/diarization/wr-08-error-envelope.test.ts",
    "apps/api/tests/unit/routes/folders/locker-04-schema.test.ts",
    "apps/api/tests/unit/routes/notes/delete-all-error-envelope.test.ts",
    "apps/api/tests/unit/routes/notes/locker-04-schema.test.ts",
    "apps/api/tests/unit/routes/plan-51-10-routes-rest.test.ts",
    "apps/api/tests/unit/routes/plan-51-12-conversations-hardening.test.ts",
    "apps/api/tests/unit/routes/plan-51-12c-locker-04-conversations.test.ts",
    "apps/api/tests/unit/routes/plan-51-12tx-transcriptions-list.test.ts",
    "apps/api/tests/unit/routes/plan-51-12tx2-parse-ttl.test.ts",
    "apps/api/tests/unit/routes/realtime/wr-09-raw-url-mutation.test.ts",
    "apps/api/tests/unit/routes/tokens/openai-realtime-zod.test.ts",
    "apps/api/tests/unit/routes/tokens/openai-realtime.test.ts",
    "packages/data/tests/encryption/plan-52-02-cleanedwhere-import.test.ts",
    "packages/data/tests/unit/__tests__/tenant-context.test.ts",
    "packages/litellm-client/tests/unit/chat-completions-stream-error-drain.test.ts",
    "packages/litellm-client/tests/unit/plan-51-15-hardening.test.ts",
    "packages/litellm-client/tests/unit/plan-51-15b-no-dead-exports.test.ts",
    "packages/litellm-client/tests/unit/plan-52-01-typecheck-pin.test.ts"
  ],
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "concurrency": 4,
  "tempDirName": ".stryker-tmp"
}
