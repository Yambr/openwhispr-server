# OpenWhispr Server — Variant A operator env scaffold
# Pairs with OpenWhispr desktop client: https://github.com/Yambr/openwhispr/releases
# Client pairing guide: docs/client.md
#
# Usage:
#   cp .env.embedded.example .env
#   # replace every REPLACE_ME with a real value (see provenance pointers)
#   docker compose -f docker-compose.embedded-litellm.yml up --wait
#
# This file carries ONLY the keys Variant A requires. HF_TOKEN is
# intentionally absent (Variant C — local Speaches with gated pyannote
# weights — needs it; Variant A does not). For Variant C operators, see
# the relocated HF_TOKEN block in .env.example under the
# "# Variant C only" banner.
#
# Generate strong random secrets with:
#   openssl rand -hex 32          # for *_SECRET, *_KEY hex tokens
#   openssl rand -base64 32 | tr -d /=+   # for *_PASSWORD
#   age-keygen -o -               # for BACKUP_AGE_IDENTITY
#   openssl rand 32 | basenc --base64url -w0 | tr -d =   # for MASTER_KEK
#
# Provider keys are intentionally NOT generated by bootstrap — paste your
# own. Endpoints whose backing key is missing surface 503 envelopes at
# request time (per the BACKEND_SPEC error-envelope contract).

# --- LiteLLM Proxy bearer + provider keys --------------------------------
# LITELLM_MASTER_KEY — auth between the api / worker and the embedded
# LiteLLM Proxy. Generate any 32+ char hex.
LITELLM_MASTER_KEY=REPLACE_ME

# OPENROUTER_API_KEY — get from https://openrouter.ai/keys
# Powers /api/reason (LLM lineup).
OPENROUTER_API_KEY=REPLACE_ME

# OPENAI_API_KEY — get from https://platform.openai.com/api-keys
# Powers WSS /v1/realtime (gpt-realtime GA).
OPENAI_API_KEY=REPLACE_ME

# LITELLM_USER_HEADER_NAME — OPT-IN end-user EMAIL attribution (upstream #4).
# When set, every gateway call carries the authenticated user's email in this
# header. Body `user` always carries email-or-UUID; x-litellm-end-user-id
# stays the stable UUID. Header NAME must be a single token (CR/LF and `:`
# refused at boot). Unset → no email header.
# LITELLM_USER_HEADER_NAME=X-OpenWhispr-User-Email

# REALTIME_FORCE_TRANSCRIPTION_MODEL — default true (upstream #1.5): operator
# model from REALTIME_TRANSCRIPTION_MODEL wins over a client-supplied realtime
# model; client `language` still passes through. Set 0/false to honor client.
# REALTIME_FORCE_TRANSCRIPTION_MODEL=true

# --- Postgres role passwords ---------------------------------------------
# POSTGRES_OWNER_PASSWORD — superuser-equivalent owner role (BYPASSRLS) used
# by the migrate runner. NEVER expose to the application.
POSTGRES_OWNER_PASSWORD=REPLACE_ME

# POSTGRES_APP_PASSWORD — non-bypass role the api/worker/web pods connect
# as via PgBouncer; subject to RLS policies.
POSTGRES_APP_PASSWORD=REPLACE_ME

# PGBOUNCER_ADMIN_PASSWORD — admin password for the special `pgbouncer`
# maintenance database.
PGBOUNCER_ADMIN_PASSWORD=REPLACE_ME

# --- Auth + cache + storage ---------------------------------------------
# BETTER_AUTH_SECRET — signing secret for Better Auth sessions. Rotating
# this invalidates every live session.
BETTER_AUTH_SECRET=REPLACE_ME

# VALKEY_PASSWORD — auth for the bundled Valkey (Redis-compatible) cache.
VALKEY_PASSWORD=REPLACE_ME

# MINIO_ROOT_PASSWORD — root credential for the bundled MinIO object store.
MINIO_ROOT_PASSWORD=REPLACE_ME

# --- Operator UI access --------------------------------------------------
# TRAEFIK_ADMIN_PASSWORD — htpasswd-style password for the Traefik
# dashboard (gated by basicauth middleware in production).
TRAEFIK_ADMIN_PASSWORD=REPLACE_ME

# GRAFANA_ADMIN_PASSWORD — login for the bundled Grafana UI.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# --- Crypto envelope + backup --------------------------------------------
# MASTER_KEK — base64url-encoded 32-byte key for the EnvKeyProvider
# (envelope encryption). Per-row DEKs wrap with this; rotation re-wraps
# DEKs without re-encrypting payloads.
MASTER_KEK=REPLACE_ME

# BACKUP_AGE_IDENTITY — age X25519 identity for borg/restic-style backup
# envelope encryption (AGE-SECRET-KEY-1...).
BACKUP_AGE_IDENTITY=REPLACE_ME

# --- Postgres derived URLs (do not edit) ---------------------------------
# These are computed from the role passwords above. They exist here so a
# fresh `docker compose -f docker-compose.embedded-litellm.yml up` works
# out of the box — every service that needs a DB URL reads one of these.
POSTGRES_OWNER_USER=openwhispr_owner
POSTGRES_APP_USER=openwhispr_app
POSTGRES_DB=openwhispr
DATABASE_URL=postgres://openwhispr_app:${POSTGRES_APP_PASSWORD}@pgbouncer:5432/openwhispr?sslmode=disable
DATABASE_URL_OWNER=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/openwhispr?sslmode=disable
LITELLM_DATABASE_URL=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/litellm?sslmode=disable
POSTGRES_ADMIN_URL=postgres://openwhispr_owner:${POSTGRES_OWNER_PASSWORD}@postgres:5432/postgres?sslmode=disable
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0
OPENWHISPR_KEY_PROVIDER=env

# --- Optional: pyannote.ai diarization (best-effort) ---------------------
# /v1/audio/diarization gracefully degrades to 503 when this is empty.
PYANNOTE_API_KEY=
