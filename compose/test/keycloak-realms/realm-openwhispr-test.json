      "lastName": "Firsttime",
      "credentials": [
        {
          "type": "password",
          "value": "erin-test-password",
          "temporary": false
        }
      ],
      "groups": ["/openwhispr-engineering"]
    },
    {
      "username": "carol",
      "email": "carol@acme.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Returning",
      "credentials": [
        {
          "type": "password",
          "value": "carol-test-password",
          "temporary": false
        }
      ],
      "groups": ["/openwhispr-engineering"]
    },
    {
      "username": "dave",
      "email": "dave@acme.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dave",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "dave-test-password",
          "temporary": false
        }
      ],
      "groups": ["/openwhispr-admin", "/openwhispr-engineering"]
    },
    {
      "username": "bob",
      "email": "bob@acme.example",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Domain",
      "credentials": [
        {
          "type": "password",
          "value": "bob-test-password",
          "temporary": false
        }
      ],
      "groups": ["/openwhispr-engineering"]
    }
  ]
}
