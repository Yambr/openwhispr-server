{
  "name": "@openwhispr/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./seed/conformance": "./src/seed/conformance.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed:conformance": "tsx src/seed/conformance.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.4.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.7.0",
    "testcontainers": "^11.14.0"
  }
}
